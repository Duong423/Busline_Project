### 15. Test WebSocket Connection Status
# Use this to verify WebSocket is working
GET http://localhost:8080/api/ai-chat/status
Accept: application/json

###

### Expected Responses Format:

### TEXT Response (for general questions):
# {
#   "content": "Để đặt vé, bạn có thể...",
#   "type": "TEXT",
#   "trips": [],
#   "suggestedQuestions": ["Tìm vé đi đâu?", "Giá vé như thế nào?"]
# }

### PRODUCT_SEARCH Response (for trip searches):
# {
#   "content": "Tôi đã tìm thấy 3 chuyến xe phù hợp...",
#   "type": "PRODUCT_SEARCH",
#   "trips": [
#     {
#       "tripId": 123,
#       "routeName": "Hà Nội - Đà Nẵng",
#       "departureLocation": "Hà Nội",
#       "arrivalLocation": "Đà Nẵng",
#       "departureTime": "2025-01-25T08:00:00",
#       "arrivalTime": "2025-01-25T14:30:00",
#       "price": 350000.0,
#       "availableSeats": 12,
#       "busType": "VIP",
#       "amenities": ["WiFi", "Điều hòa", "Nước uống"],
#       "rating": 4.5,
#       "hasPromotion": false,
#       "imageUrl": "https://..."
#     }
#   ],
#   "suggestedQuestions": [
#     "Chuyến nào rẻ nhất?",
#     "Chuyến nào đi sớm nhất?"
#   ]
# }

### ERROR Response (when something goes wrong):
# {
#   "content": "Xin lỗi, tôi không tìm thấy chuyến nào phù hợp...",
#   "type": "ERROR",
#   "trips": [],
#   "suggestedQuestions": ["Thử tìm tuyến khác?"]
# }

###

### Notes:
# 1. Make sure application is running: mvn spring-boot:run
# 2. Database should have real trip data
# 3. OpenRouter API key should be configured
# 4. Check logs for intent extraction results
# 5. Verify location names match database entries
