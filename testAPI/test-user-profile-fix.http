### Test 1: Login với user duongnt.21it@vku.udn.vn
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "duongnt.21it@vku.udn.vn",
  "password": "your_password_here"
}

### Test 2: Lấy profile với token của duongnt.21it@vku.udn.vn
# Copy token từ response Test 1 và paste vào đây
GET http://localhost:8080/api/users/profile
Authorization: Bearer {{token_duongnt}}

